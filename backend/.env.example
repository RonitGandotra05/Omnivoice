# OmniVoice / backend — copy to backend/.env
DATABASE_URL=sqlite+aiosqlite:///./local.db
FRONTEND_URL=http://localhost:3000
DEBUG=false

# Local simulations work without these. Never put secrets in NEXT_PUBLIC_* variables.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Keep disabled until you intentionally enable phone calls.
LIVE_CALLS_ENABLED=false
# A random server-side operator key for live calls, knowledge, and company APIs.
INTEGRATION_API_KEY=
# Dedicated agent per company UUID. The trial agent cannot be used for company knowledge.
ELEVENLABS_COMPANY_AGENTS={}
# Example: {"company-uuid":"agent_dedicated_to_company"}
JWT_SECRET=replace-with-a-long-random-secret

# Browser voice sessions and document synchronization (explicit opt-in)
WEB_VOICE_ENABLED=false
# HMAC secret from the ElevenLabs post-call webhook configuration
ELEVENLABS_WEBHOOK_SECRET=

# SMTP escalation delivery; tickets work without email credentials.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Public demo is for local exploration. Production mode requires PostgreSQL,
# strong operator/JWT secrets, rate limiting on, and public demo disabled.
PRODUCTION_MODE=false
PUBLIC_DEMO_ENABLED=true
RATE_LIMIT_ENABLED=true
IP_REQUESTS_PER_MINUTE=600
API_REQUESTS_PER_MINUTE=180
UPLOADS_PER_MINUTE=120

# Safe document/OCR limits. Install Tesseract and required language packs.
MAX_DOCUMENTS=100
MAX_WORKSPACE_CHARACTERS=5000000
MAX_DOCUMENT_CHARACTERS=200000
PARSER_CONCURRENCY=2
PARSER_TIMEOUT_SECONDS=150
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_MIN_CONFIDENCE=70
PDF_MAX_PAGES=100
PDF_MAX_OCR_PAGES=30
PDF_MAX_RENDER_PIXELS=20000000
RAG_EMBEDDING_MODEL=e5_mistral_7b_instruct
RAG_INDEX_TIMEOUT_SECONDS=180
# Review all OCR output before including it in customer answers (recommended).
OCR_REVIEW_REQUIRED=true
# Optional: set TESSDATA_PREFIX only if you install a custom tessdata_best directory.

# Production uploads fail closed unless malware scanning and the Linux sandbox work.
MALWARE_SCAN_ENABLED=false
CLAMD_SOCKET=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=30
PARSER_SANDBOX_REQUIRED=false

# Generate your own key with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Example structure only: DATA_ENCRYPTION_KEYS={"key-2026":"YOUR_BASE64_32_BYTE_KEY"}
DATA_ENCRYPTION_KEYS={}
DATA_ENCRYPTION_ACTIVE_KEY=
ALLOW_LEGACY_PLAINTEXT_READS=true

# Public HTTPS origin of this backend, reachable by the voice platform.
# Localhost permits local demos but does not activate native caller tools.
API_BASE_URL=http://127.0.0.1:8000
