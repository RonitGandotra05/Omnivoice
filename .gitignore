# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node modules (global catch-all)
node_modules/

# ── Frontend (Next.js) ───────────────────────────────────────────────
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.yarn/install-state.gz
frontend/coverage/
frontend/.next/
frontend/out/
frontend/build/
frontend/.eslintcache
frontend/.stylelintcache

# ── Backend (Python) ─────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/venv/
backend/.venv/
backend/*.egg-info/
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# ── Shared ───────────────────────────────────────────────────────────

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System files
.DS_Store
._*
*.pem

# Editor directories
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# Environment variables
.env
.env.*
.env*.local
.env.*.local
!.env.example

# Turborepo cache
.turbo

# Private credentials
*.key
*.p12
*.pfx

# Rebuilt by the parser asset preparation script
frontend/public/vendor/

# Local Netlify folder
.netlify

# Local hosting state and verification suites (not committed)
.netlify/
frontend/.netlify/
frontend/tests/*
!frontend/tests/company-assistant*.mjs
!frontend/tests/start-assistant-ui.mjs
backend/tests/
docs/test-fixtures/

# Local verification runners
frontend/scripts/check-live-voice.mjs
frontend/scripts/verify-next.mjs
frontend/scripts/verify-ui.cjs

# Generated by the hosting edge bundler
frontend/deno.lock

# Local-only verification, captures and generated documentation
**/__tests__/
**/*.test.*
**/*.spec.*
**/test-results/
**/playwright-report/
**/coverage/
screenshots/
previews/
artifacts/
docs/test-fixtures/
docs/research/
docs/*preview*
docs/*hero*
docs/visual-assets.md
docs/verification*.md
docs/*audit*.md
docs/*AUDIT*.md

# Keep the company-assistant regression suite with its implementation.
!frontend/tests/company-assistant.test.mjs

!frontend/tests/voice-intake*.mjs

!frontend/tests/admin-minutes*.mjs

!frontend/tests/voice-fallback*.mjs
docs/audits/voice-handoff-2026-10-24/callback-intake.json
docs/audits/voice-handoff-2026-10-24/eric-support-sample.mp3
docs/audits/voice-handoff-2026-10-24/fallback-scope.json
docs/audits/voice-handoff-2026-10-24/README.md
