# OmniVoice / frontend — copy to frontend/.env.local
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Only needed for existing operator accounts, not the public playground.
NEON_DB_CONNECTION_STRING=
JWT_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-different-long-random-secret

# Optional server-side contact email. Leave empty to show setup guidance.
CONTACT_EMAIL=

# Optional SSO configuration; SSO is not administrator authorization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INTEGRATION_API_KEY=

# Company studio: server-side only. Connected mode requires administrator sign-in.
BACKEND_URL=http://127.0.0.1:8000
SUPPORT_COMPANY_ID=
SUPPORT_API_KEY=
