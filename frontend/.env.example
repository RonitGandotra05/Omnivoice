# Copy to .env.local. Real credentials belong only in .env.local / Netlify.
PUBLIC_APP_URL=http://127.0.0.1:3000
SUPPORT_STORAGE=browser
ELEVENLABS_API_KEY=
DATABASE_URL=
# Generate independent random values of at least 32 characters.
STUDIO_SESSION_SECRET=
JWT_SECRET=
# Demos require a verified account: 600 seconds. Shared rolling 24-hour budgets.
DEMO_PROTECTION_ENABLED=true
DEMO_SITE_DAILY_LIMIT=20
EMAIL_ENABLED=false
NATIVE_CALLS_ENABLED=false

# Account sign-in. Never use NEXT_PUBLIC_ for these secrets.
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional account security notices. Google signup does not require SMTP.
ACCOUNT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional dedicated 32-byte base64 key for encrypted authenticator seeds.
# Otherwise a purpose-separated key is derived from JWT_SECRET: keep it stable.
AUTH_MFA_KEY=
# Operator access requires enrollment in production by default.
OPERATOR_MFA_REQUIRED=true

# Company-profile assistant: server only. Shared PostgreSQL is required, even in browser storage mode.
GEMINI_API_KEY=
COMPANY_AI_ENABLED=true
COMPANY_AI_MODEL=gemini-3.5-flash-lite
COMPANY_AI_REQUESTS_PER_MINUTE=3
COMPANY_AI_USER_DAILY=30
COMPANY_AI_USER_DAILY_TOKENS=250000
COMPANY_AI_IP_PER_MINUTE=15
COMPANY_AI_IP_DAILY=150
COMPANY_AI_SITE_CONCURRENCY=10
COMPANY_AI_SITE_DAILY=500
COMPANY_AI_SITE_DAILY_TOKENS=2000000
COMPANY_AI_SITE_DAILY_USD=5
# Update these server prices when changing model or provider pricing (USD per million tokens).
COMPANY_AI_INPUT_USD_PER_MILLION=0.30
COMPANY_AI_OUTPUT_USD_PER_MILLION=2.50

# Conversational support voice, server controlled. Eric with expressive v4 Turbo.
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
VOICE_TTS_MODEL=eleven_v4_turbo
# Country-specific accents use Netlify's trusted request context; no IP lookup service.
VOICE_REGIONAL_ENABLED=true
# Optional per-country overrides, only after the voice is accessible to this API key.
# Indian library voices currently require an eligible ElevenLabs paid plan/API credits.
# ELEVENLABS_VOICE_ID_IN=nMk40SWEJ6fx4KdJU3tB
# ELEVENLABS_VOICE_ID_US=cjVigY5qzO86Huf0OWal
# ELEVENLABS_VOICE_ID_GB=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_ID_AU=IKne3meq5aSn9XLyUdCD
