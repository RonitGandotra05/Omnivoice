# Copy to .env.local. Real credentials belong only in .env.local / Netlify.
PUBLIC_APP_URL=http://127.0.0.1:3000
SUPPORT_STORAGE=browser
ELEVENLABS_API_KEY=
DATABASE_URL=
# Generate independent random values of at least 32 characters.
STUDIO_SESSION_SECRET=
JWT_SECRET=
# Guests: 60 seconds. Verified accounts: 600 seconds. Shared rolling 24-hour budgets.
DEMO_PROTECTION_ENABLED=true
DEMO_SITE_DAILY_LIMIT=20
EMAIL_ENABLED=false
NATIVE_CALLS_ENABLED=false

# Account sign-in. Never use NEXT_PUBLIC_ for these secrets.
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
# Apple Services ID and signed client-secret JWT (expires; renew before expiry).
APPLE_ID=
APPLE_SECRET=
# Account verification/reset emails; independent of support escalation email.
ACCOUNT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
